APP_NAME=SGP
APP_ENV=local
# Gere com: php artisan key:generate
# Nunca compartilhe o .env nem use a mesma APP_KEY em outro ambiente.
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco (padrao local: SQLite) ---
DB_CONNECTION=sqlite
# Para MySQL local, comente a linha acima e descomente:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=SGP
# DB_USERNAME=laravel
# DB_PASSWORD=password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Token Sanctum expira após N minutos (padrão: 480 = 8h). Deixe vazio para não expirar.
SANCTUM_TOKEN_EXPIRATION=480

# Em production, seeders de demo só rodam com ALLOW_DEMO_SEED=true
# ALLOW_DEMO_SEED=false

VITE_APP_NAME="${APP_NAME}"
# Proxy de /IMG no Vite (artisan serve local)
VITE_IMG_PROXY=http://127.0.0.1:8000
