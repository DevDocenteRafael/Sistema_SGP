# =============================================================================
# MYSQL DO DOCKER (SGP) — PORTA NA SUA MAQUINA (HOST)
# =============================================================================
# Padrao do time: 3308 (mesma config em casa e no trabalho).
#
# MySQL LOCAL da maquina NAO e usado pelo SGP com Docker:
#   - Casa: MySQL local costuma estar na 3306
#   - Trabalho: MySQL local costuma estar na 3307
#
# O SGP usa o MySQL DENTRO do Docker. Esta porta (3308) e so para:
#   - MySQL Workbench / DBeaver no Windows (localhost:3308)
#
# O Laravel (container) usa DB_HOST=mysql e DB_PORT=3306 (rede interna Docker).
# Nao altere DB_PORT para 3308.
# =============================================================================
MYSQL_HOST_PORT=3308
